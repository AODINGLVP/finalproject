[gd_resource type="Resource" script_class="BTTreeResource" format=3 uid="uid://b5rxb5tqnjv7n"]

[ext_resource type="Script" uid="uid://bx4g01fp01uuo" path="res://addons/behavior_tree_editor/bt_tree_resource.gd" id="1_tree"]
[ext_resource type="Script" uid="uid://b8o5ywdnkpnh8" path="res://addons/behavior_tree_editor/bt_node_resource.gd" id="2_node"]

[sub_resource type="Resource" id="BTNodeResource_root"]
script = ExtResource("2_node")
id = 1
title = "Root"
node_type = "Root"
position = Vector2(525, 100)
description = "Entry point for the NPC behavior tree."

[sub_resource type="Resource" id="BTNodeResource_selector"]
script = ExtResource("2_node")
id = 2
title = "Decide Behavior"
node_type = "Selector"
position = Vector2(525, 440)
parent_id = 1
description = "Try chase behavior first, then fall back to patrol."

[sub_resource type="Resource" id="BTNodeResource_sequence"]
script = ExtResource("2_node")
id = 3
title = "Chase Branch"
node_type = "Sequence"
position = Vector2(300, 780)
parent_id = 2
description = "Only chase when a target exists."

[sub_resource type="Resource" id="BTNodeResource_condition"]
script = ExtResource("2_node")
id = 4
title = "Has Target"
node_type = "Condition"
position = Vector2(120, 1120)
parent_id = 3
description = "Checks blackboard.has_target."
parameters = {
"blackboard_key": "has_target",
"expected": true
}

[sub_resource type="Resource" id="BTNodeResource_chase"]
script = ExtResource("2_node")
id = 5
title = "Chase Target"
position = Vector2(480, 1120)
parent_id = 3
description = "Calls chase_target on the NPC agent."
parameters = {
"action_name": "chase_target"
}

[sub_resource type="Resource" id="BTNodeResource_patrol"]
script = ExtResource("2_node")
id = 6
title = "Patrol"
position = Vector2(750, 780)
parent_id = 2
description = "Calls patrol on the NPC agent."
parameters = {
"action_name": "patrol"
}

[resource]
script = ExtResource("1_tree")
tree_name = "Demo NPC Tree"
root_node_id = 1
nodes = Array[ExtResource("2_node")]([SubResource("BTNodeResource_root"), SubResource("BTNodeResource_selector"), SubResource("BTNodeResource_sequence"), SubResource("BTNodeResource_condition"), SubResource("BTNodeResource_chase"), SubResource("BTNodeResource_patrol")])
