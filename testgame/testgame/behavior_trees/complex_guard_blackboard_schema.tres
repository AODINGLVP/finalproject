[resource]
script = ExtResource("1_schema")
entries = Array[ExtResource("2_entry")]([SubResource("Entry_player_detected"), SubResource("Entry_player_in_range"), SubResource("Entry_player_on_left"), SubResource("Entry_player_on_right"), SubResource("Entry_player_x"), SubResource("Entry_health"), SubResource("Entry_health_ratio"), SubResource("Entry_low_health"), SubResource("Entry_critical_health"), SubResource("Entry_last_known_player_x"), SubResource("Entry_has_last_known_position")])
